{
  "msconvert": {
    "output_format": {
      "type": "enum",
      "default": "mzML",
      "description": "Output format",
      "enum": [
        "mzML",
        "mzXML",
        "mz5",
        "mzMLb",
        "mgf",
        "text",
        "ms1",
        "ms2",
        "cms1",
        "cms2"
      ],
      "primary": true
    },
    "precision": {
      "type": "int",
      "default": 64,
      "description": "Binary precision (bits)",
      "enum": [
        32,
        64
      ],
      "primary": true
    },
    "zlib": {
      "type": "bool",
      "default": true,
      "description": "Enable zlib compression",
      "primary": true
    },
    "filters": {
      "type": "str_list",
      "default": [
        "peakPicking true 1-"
      ],
      "description": "Spectrum list filters，每行一条；默认含质心化 filter",
      "primary": true
    },
    "chromatogram_filters": {
      "type": "str_list",
      "default": [],
      "description": "Repeated chromatogram filters"
    },
    "extension": {
      "type": "str",
      "default": null,
      "description": "Output extension override"
    },
    "mz_precision": {
      "type": "int",
      "default": null,
      "description": "m/z precision"
    },
    "inten_precision": {
      "type": "int",
      "default": null,
      "description": "Intensity precision"
    },
    "mz_truncation": {
      "type": "int",
      "default": null,
      "description": "m/z truncation bits"
    },
    "inten_truncation": {
      "type": "int",
      "default": null,
      "description": "Intensity truncation bits"
    },
    "mz_delta": {
      "type": "bool",
      "default": false,
      "description": "Enable m/z delta prediction"
    },
    "inten_delta": {
      "type": "bool",
      "default": false,
      "description": "Enable intensity delta prediction"
    },
    "mz_linear": {
      "type": "bool",
      "default": false,
      "description": "Enable m/z linear prediction"
    },
    "inten_linear": {
      "type": "bool",
      "default": false,
      "description": "Enable intensity linear prediction"
    },
    "noindex": {
      "type": "bool",
      "default": false,
      "description": "Disable index generation"
    },
    "numpress_linear": {
      "type": "bool",
      "default": false,
      "description": "Enable numpress linear prediction compression for m/z and RT"
    },
    "numpress_linear_abs_tol": {
      "type": "float",
      "default": null,
      "description": "Numpress linear absolute tolerance"
    },
    "numpress_pic": {
      "type": "bool",
      "default": false,
      "description": "Enable numpress pic"
    },
    "numpress_slof": {
      "type": "bool",
      "default": false,
      "description": "Enable numpress slof"
    },
    "numpress_all": {
      "type": "bool",
      "default": false,
      "description": "Enable all numpress codecs"
    },
    "outfile": {
      "type": "str",
      "default": null,
      "description": "Output file name"
    },
    "contact_info": {
      "type": "str",
      "default": null,
      "description": "Contact info file"
    },
    "filelist": {
      "type": "str",
      "default": null,
      "description": "Input file list"
    },
    "config_file": {
      "type": "str",
      "default": null,
      "description": "msconvert config file"
    },
    "verbose": {
      "type": "bool",
      "default": true,
      "description": "Verbose logging"
    },
    "single_threaded": {
      "type": "bool",
      "default": false,
      "description": "Single-threaded conversion"
    },
    "continue_on_error": {
      "type": "bool",
      "default": false,
      "description": "Continue on error"
    },
    "merge": {
      "type": "bool",
      "default": false,
      "description": "Merge multiple inputs"
    },
    "combine_ion_mobility_spectra": {
      "type": "bool",
      "default": false,
      "description": "Combine ion mobility spectra"
    },
    "dda_processing": {
      "type": "bool",
      "default": false,
      "description": "Enable DDA processing"
    },
    "gzip": {
      "type": "bool",
      "default": false,
      "description": "Gzip output"
    },
    "sim_as_spectra": {
      "type": "bool",
      "default": false,
      "description": "Write SIM as spectra"
    },
    "srm_as_spectra": {
      "type": "bool",
      "default": false,
      "description": "Write SRM as spectra"
    },
    "ignore_calibration_scans": {
      "type": "bool",
      "default": false,
      "description": "Ignore calibration scans"
    },
    "accept_zero_length_spectra": {
      "type": "bool",
      "default": false,
      "description": "Accept zero-length spectra"
    },
    "ignore_missing_zero_samples": {
      "type": "bool",
      "default": false,
      "description": "Ignore missing zero samples"
    },
    "ignore_unknown_instrument_error": {
      "type": "bool",
      "default": false,
      "description": "Ignore unknown instrument errors"
    },
    "strip_location_from_source_files": {
      "type": "bool",
      "default": false,
      "description": "Strip source file location"
    },
    "strip_version_from_software": {
      "type": "bool",
      "default": false,
      "description": "Strip software version"
    },
    "mzmlb_chunk_size": {
      "type": "int",
      "default": null,
      "description": "mzMLb chunk size"
    },
    "mzmlb_compression_level": {
      "type": "int",
      "default": null,
      "description": "mzMLb compression level"
    },
    "run_index_set": {
      "type": "str",
      "default": null,
      "description": "Run index set"
    }
  },
  "topfd": {
    "activation": {
      "type": "enum",
      "default": "FILE",
      "description": "MS/MS activation",
      "enum": [
        "FILE",
        "CID",
        "ETD",
        "HCD",
        "MPD",
        "UVPD"
      ],
      "primary": true
    },
    "max_charge": {
      "type": "int",
      "default": 30,
      "description": "Maximum charge",
      "primary": true
    },
    "max_mass": {
      "type": "float",
      "default": 70000.0,
      "description": "Maximum mass",
      "primary": true
    },
    "mz_error": {
      "type": "float",
      "default": 0.02,
      "description": "m/z tolerance (Da)",
      "primary": true
    },
    "ms_one_sn_ratio": {
      "type": "float",
      "default": 3.0,
      "description": "MS1 S/N ratio",
      "primary": true
    },
    "ms_two_sn_ratio": {
      "type": "float",
      "default": 1.0,
      "description": "MS2 S/N ratio",
      "primary": true
    },
    "precursor_window": {
      "type": "float",
      "default": 3.0,
      "description": "Precursor window (m/z)"
    },
    "thread_number": {
      "type": "int",
      "default": 4,
      "description": "Thread count",
      "min": 1,
      "primary": true
    },
    "use_msdeconv": {
      "type": "bool",
      "default": false,
      "description": "Use MS-Deconv score instead of the default EnvCNN scorer"
    },
    "env_cnn_cutoff": {
      "type": "float",
      "default": 0.0,
      "description": "EnvCNN score cutoff for MS/MS envelopes [0,1]",
      "min": 0.0,
      "max": 1.0
    },
    "ecscore_cutoff": {
      "type": "float",
      "default": 0.1,
      "description": "ECScore cutoff for proteoform features [0,1]",
      "min": 0.0,
      "max": 1.0,
      "primary": true
    },
    "min_scan_number": {
      "type": "int",
      "default": 1,
      "description": "Minimum MS1 scans for a proteoform feature (1|2|3)",
      "enum": [
        1,
        2,
        3
      ]
    },
    "split_intensity_ratio": {
      "type": "float",
      "default": 2.5,
      "description": "Intensity ratio required to split a feature",
      "min": 0.0,
      "xmin": true
    },
    "missing_level_one": {
      "type": "bool",
      "default": false,
      "description": "Missing MS1 spectra"
    },
    "single_scan_noise": {
      "type": "bool",
      "default": false,
      "description": "Use per-MS1-scan noise instead of LC-MS-wide noise"
    },
    "disable_additional_feature_search": {
      "type": "bool",
      "default": false,
      "description": "Disable the additional proteoform feature search"
    },
    "disable_frag_num_filtering": {
      "type": "bool",
      "default": false,
      "description": "Skip MS/MS fragment-number-based envelope filtering"
    },
    "skip_html_folder": {
      "type": "bool",
      "default": false,
      "description": "Skip HTML folder"
    },
    "extra_cmdline": {
      "type": "str",
      "default": "",
      "description": "Escape hatch: extra topfd arguments inserted before the spectrum file (shell-quoted)"
    }
  },
  "toppic": {
    "activation": {
      "type": "enum",
      "default": "FILE",
      "description": "Activation type",
      "enum": [
        "FILE",
        "CID",
        "ETD",
        "HCD",
        "MPD",
        "UVPD"
      ],
      "primary": true
    },
    "fixed_mod": {
      "type": "str",
      "default": null,
      "description": "Fixed modification (C57|C58|<file>)",
      "primary": true
    },
    "n_terminal_form": {
      "type": "str",
      "default": null,
      "description": "Allowed N-terminal forms (comma list of NONE/NME/NME_ACETYLATION/M_ACETYLATION)"
    },
    "proteoform_type": {
      "type": "str",
      "default": null,
      "description": "Allowed proteoform types (comma list of COMPLETE/PREFIX/SUFFIX/INTERNAL)"
    },
    "thread_number": {
      "type": "int",
      "default": 4,
      "description": "Thread count",
      "min": 1,
      "primary": true
    },
    "mass_error_tolerance": {
      "type": "float",
      "default": null,
      "description": "Mass error tolerance (ppm); when lookup_table=true must be 5, 10, or 15",
      "primary": true
    },
    "num_shift": {
      "type": "int",
      "default": null,
      "description": "Maximum unexpected modifications per PrSM (0|1|2)",
      "enum": [
        0,
        1,
        2
      ],
      "primary": true
    },
    "min_shift": {
      "type": "int",
      "default": null,
      "description": "Min shift (Da)"
    },
    "max_shift": {
      "type": "int",
      "default": null,
      "description": "Max shift (Da)"
    },
    "variable_ptm_num": {
      "type": "int",
      "default": null,
      "description": "Maximum variable modifications per PrSM"
    },
    "variable_ptm_file_name": {
      "type": "str",
      "default": null,
      "description": "Variable modification file"
    },
    "proteoform_error_tolerance": {
      "type": "float",
      "default": null,
      "description": "Proteoform cluster error tolerance (Da)"
    },
    "spectrum_cutoff_type": {
      "type": "enum",
      "default": null,
      "description": "Spectrum cutoff type",
      "enum": [
        "EVALUE",
        "FDR"
      ],
      "primary": true
    },
    "spectrum_cutoff_value": {
      "type": "float",
      "default": null,
      "description": "Spectrum cutoff value",
      "primary": true
    },
    "proteoform_cutoff_type": {
      "type": "enum",
      "default": null,
      "description": "Proteoform cutoff type",
      "enum": [
        "EVALUE",
        "FDR"
      ],
      "primary": true
    },
    "proteoform_cutoff_value": {
      "type": "float",
      "default": null,
      "description": "Proteoform cutoff value",
      "primary": true
    },
    "num_combined_spectra": {
      "type": "int",
      "default": null,
      "description": "Number of combined spectra (alternating fragmentation)"
    },
    "mod_file_name": {
      "type": "str",
      "default": null,
      "description": "Local PTM (common modification) file for unexpected-shift characterization"
    },
    "miscore_threshold": {
      "type": "float",
      "default": null,
      "description": "Modification identification score threshold [0,1]",
      "min": 0.0,
      "max": 1.0
    },
    "decoy": {
      "type": "bool",
      "default": false,
      "description": "Use decoy search",
      "primary": true
    },
    "approximate_spectra": {
      "type": "bool",
      "default": false,
      "description": "Use approximate spectra for protein filtering (faster, may reduce sensitivity)"
    },
    "lookup_table": {
      "type": "bool",
      "default": false,
      "description": "Use lookup table for p/E-values; requires mass_error_tolerance ∈ {5, 10, 15} ppm"
    },
    "no_topfd_feature": {
      "type": "bool",
      "default": false,
      "description": "No TopFD feature handoff"
    },
    "skip_html_folder": {
      "type": "bool",
      "default": false,
      "description": "Skip HTML folder"
    },
    "keep_temp_files": {
      "type": "bool",
      "default": false,
      "description": "Keep temp files"
    },
    "keep_decoy_ids": {
      "type": "bool",
      "default": false,
      "description": "Keep decoy IDs"
    },
    "combined_file_name": {
      "type": "str",
      "default": null,
      "description": "Combined output name"
    },
    "msalign_preflight_blocks": {
      "type": "int",
      "default": 10,
      "description": "Msalign preflight sample blocks"
    },
    "extra_cmdline": {
      "type": "str",
      "default": "",
      "description": "Escape hatch: extra toppic arguments inserted before the fasta/msalign positional arguments (shell-quoted)"
    }
  },
